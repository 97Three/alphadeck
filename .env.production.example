# AlphaDeck strict production configuration template
# ===================================================
# Copy this file OUTSIDE the repository, replace every placeholder, then run:
#   npm run check:production -- --env-file /secure/path/alphadeck.env
# Inject the same public/build values at build time and all values at runtime.
# Prefer an orchestrator secret manager over a long-lived file.
#
# The template chooses the recommended topology: Qwen and daily DeepSeek through
# ModelPort, Memory enabled through a short-lived token broker. Alternative direct
# DeepSeek and Memory-disabled settings are documented inline and in
# docs/configuration.md. Do not commit the populated file.

# Runtime and canonical public origin
NODE_ENV=production
ALPHADECK_DEGRADATION_MODE=strict
NEXT_PUBLIC_APP_URL=https://alphadeck.example.com
BETTER_AUTH_URL=https://alphadeck.example.com
ALPHADECK_WEB_HOST=0.0.0.0
PORT=3000

# Authentication and browser security
ALPHADECK_AUTH_SECRET=replace-with-32-plus-random-characters
ALPHADECK_AUTH_MODE=local
ALPHADECK_AUTH_SECURE_COOKIES=1
ALPHADECK_SECURITY_HSTS=1
ALPHADECK_AUTH_TRUSTED_ORIGINS=https://alphadeck.example.com
ALPHADECK_AUTH_ALLOW_SIGNUP=0
ALPHADECK_AUTH_REMEMBER_ME=0
ALPHADECK_AUTH_AUDIT_RETENTION_DAYS=180
ALPHADECK_AUTH_EXPIRED_RECORD_GRACE_SECONDS=3600

# Use --require-bootstrap only for the one-time administrator bootstrap. Remove
# both values from the long-running service environment after bootstrap.
ALPHADECK_AUTH_ADMIN_EMAIL=admin@example.com
ALPHADECK_AUTH_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
ALPHADECK_AUTH_ADMIN_NAME=AlphaDeck 管理员

# Durable stores. PROJECTS_DIR must be shared by every pod allowed to execute the
# same project/namespace, and must survive application restarts.
DATABASE_URL=postgresql://alphadeck:replace-with-database-password@timescaledb:5432/alphadeck?schema=public
REDIS_URL=redis://redis:6379/0
PROJECTS_DIR=/var/lib/alphadeck/projects
# Shared durable volume, outside immutable application releases; include in backups.
ALPHADECK_SKILLS_STATE_DIR=/var/lib/alphadeck/skill-catalog
ENCRYPTION_KEY=replace-with-64-hex-characters

# Required service topology
ALPHADECK_DATABASE_ENABLED=1
ALPHADECK_DATABASE_REQUIRED=1
ALPHADECK_MARKET_API_ENABLED=1
ALPHADECK_MARKET_API_REQUIRED=1
ALPHADECK_MARKET_API_URL=http://market-data:8000
ALPHADECK_MARKET_ADMIN_TOKEN=replace-with-32-plus-random-characters
ALPHADECK_MARKET_MAINTENANCE_ENABLED=1
ALPHADECK_MARKET_MAINTENANCE_UNIVERSE_ID=a-share-sample-research-pool
ALPHADECK_MARKET_CALENDAR_LOOKBACK_DAYS=30
ALPHADECK_MARKET_HISTORY_LOOKBACK_DAYS=14
ALPHADECK_MARKET_MAINTENANCE_REQUEST_DELAY_SECONDS=0.2
ALPHADECK_MARKET_MAINTENANCE_BATCH_DELAY_SECONDS=0.7
ALPHADECK_MARKET_MAINTENANCE_BATCH_SIZE=25
ALPHADECK_MARKET_MAINTENANCE_MAX_RETRIES=3
ALPHADECK_MARKET_MAINTENANCE_POLL_INTERVAL_MS=2000
ALPHADECK_MARKET_CALENDAR_TIMEOUT_MS=120000
ALPHADECK_MARKET_INGESTION_TIMEOUT_MS=1800000
ALPHADECK_MARKET_FRESHNESS_MIN_SYMBOLS=250
ALPHADECK_REDIS_CACHE_ENABLED=1
ALPHADECK_REDIS_REQUIRED=1
ALPHADECK_OBSERVABILITY_ENABLED=1
ALPHADECK_OBSERVABILITY_REQUIRED=1
ALPHADECK_CLICKHOUSE_ENABLED=0
ALPHADECK_CLICKHOUSE_REQUIRED=0

# Observability endpoints. Keep anonymous Grafana access disabled in production.
LOKI_URL=http://loki:3100
GRAFANA_ANONYMOUS_ENABLED=0
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# Model access — recommended topology
# MODELPORT_API_KEY is a scoped ModelPort client key. DeepSeek/Qwen upstream keys
# remain in ModelPort and must never be copied into AlphaDeck.
MODELPORT_API_KEY=replace-with-production-modelport-client-key
ALPHADECK_MODELPORT_URL=https://modelport.internal.example
ALPHADECK_MODELPORT_ENABLED=1
ALPHADECK_MODELPORT_REQUIRED=1
ALPHADECK_MODELPORT_ORGANIZATION_ID=org_alphadeck
ALPHADECK_MODELPORT_PROJECT_ID=prj_alphadeck
ALPHADECK_MODELPORT_ENVIRONMENT_ID=env_production

ALPHADECK_KNOWLEDGE_ENABLED=1
ALPHADECK_KNOWLEDGE_REQUIRED=1
ALPHADECK_KNOWLEDGE_API_URL=https://knowledge.internal.example
ALPHADECK_KNOWLEDGE_PURPOSE=quant-research
ALPHADECK_KNOWLEDGE_SPACES=https://knowledge.internal.example/spaces/quant-research
ALPHADECK_KNOWLEDGE_PROJECT_SPACES_ENABLED=1
ALPHADECK_KNOWLEDGE_PROJECT_SPACE_BASE_URL=https://knowledge.internal.example/spaces/alphadeck/projects
ALPHADECK_KNOWLEDGE_TIMEOUT_MS=2000
ALPHADECK_KNOWLEDGE_MAX_CONTEXT_CHARACTERS=8000
ALPHADECK_KNOWLEDGE_BEARER_TOKEN=
ALPHADECK_KNOWLEDGE_OAUTH_TOKEN_URL=https://identity.internal.example/oauth2/token
ALPHADECK_KNOWLEDGE_OAUTH_CLIENT_ID=alphadeck
ALPHADECK_KNOWLEDGE_OAUTH_CLIENT_SECRET=inject-from-secret-manager
ALPHADECK_KNOWLEDGE_OAUTH_RESOURCE=https://knowledge.internal.example/akep/0.1
ALPHADECK_KNOWLEDGE_OAUTH_SCOPE="akep:query akep:read akep:feedback"
ALPHADECK_LLM_AGENT_ENABLED=1
ALPHADECK_LLM_QUERY_REWRITE_ENABLED=1
ALPHADECK_QUERY_REWRITE_LLM_TIMEOUT_MS=12000
ALPHADECK_QUERY_REWRITE_LLM_MAX_RETRIES=0

# Optional official-direct DeepSeek profile. Inject this variable only when projects
# explicitly select `deepseek-v4-flash`. It does not change the Qwen global default.
# DEEPSEEK_API_KEY=inject-with-your-secret-manager

# Evolvable User Memory — production-enabled example
# ENABLED=0 is a supported normal deployment and then every remaining MEMORY_* value
# may be omitted. REQUIRED=0 only permits degradation; it does not disable Memory.
ALPHADECK_MEMORY_ENABLED=1
ALPHADECK_MEMORY_REQUIRED=1
ALPHADECK_MEMORY_REQUIRE_PRODUCTION_READY=1
ALPHADECK_MEMORY_API_URL=https://memory.internal.example.com
ALPHADECK_MEMORY_TENANT_ID=alphadeck-production
ALPHADECK_MEMORY_TIMEOUT_MS=1200
ALPHADECK_MEMORY_RECALL_LIMIT=6
ALPHADECK_MEMORY_MAX_CONTEXT_CHARACTERS=2000
# Static ALPHADECK_MEMORY_BEARER_TOKEN is forbidden for multi-user production.
ALPHADECK_MEMORY_BEARER_TOKEN=
ALPHADECK_MEMORY_TOKEN_BROKER_URL=https://identity.internal.example.com/memory-token
ALPHADECK_MEMORY_TOKEN_BROKER_CLIENT_ID=alphadeck-production
ALPHADECK_MEMORY_TOKEN_BROKER_CLIENT_SECRET=replace-with-token-broker-client-secret
ALPHADECK_MEMORY_TOKEN_AUDIENCE=evolvable-memory-api
ALPHADECK_MEMORY_PRODUCTION_PROBE_SUBJECT_ID=svc_alphadeck_readiness

# Host-level administration. The internal token API remains off unless a separately
# authenticated trusted control plane explicitly requires it.
ALPHADECK_ADMIN_TOKEN=replace-with-32-plus-random-characters
ALPHADECK_ENABLE_INTERNAL_TOKEN_API=0
ALPHADECK_INTERNAL_API_TOKEN=

# Generated workspace isolation and distributed execution identity
ALPHADECK_GENERATED_SANDBOX=1
ALPHADECK_ALLOW_UNSANDBOXED_GENERATED_CODE=0
PI_AGENT_WORKSPACE_NAMESPACE=alphadeck-production
PI_AGENT_INSTANCE_ID=
PI_AGENT_TIMEOUT_MS=1200000
PI_AGENT_LEASE_TTL_MS=60000
PI_AGENT_HEARTBEAT_INTERVAL_MS=15000
PI_AGENT_DISPATCH_MODE=worker
PI_AGENT_DISPATCH_LEASE_TTL_MS=120000
PI_AGENT_DISPATCH_HEARTBEAT_INTERVAL_MS=30000
PI_AGENT_DISPATCH_PENDING_ORPHAN_GRACE_MS=120000
PI_AGENT_DISPATCH_RETRY_BASE_DELAY_MS=5000
PI_AGENT_WORKER_POLL_INTERVAL_MS=1000
PI_AGENT_WORKER_CONCURRENCY=2
# Must be identical for every live Worker sharing this PostgreSQL/pool. Worker
# registration fails closed when a different live value already exists.
PI_AGENT_WORKER_GLOBAL_CONCURRENCY=4
PI_AGENT_WORKER_CLAIM_BATCH_SIZE=20
# These intervals protect both process registration and execution-slot leases.
PI_AGENT_WORKER_SLOT_LEASE_TTL_MS=120000
PI_AGENT_WORKER_SLOT_HEARTBEAT_INTERVAL_MS=30000
PI_AGENT_RESOURCE_LOCK_WAIT_MS=5000

# Release evaluation assurance. Paths must be mounted secrets, not repository files.
ALPHADECK_REQUIRE_HIDDEN_EVAL=1
ALPHADECK_REQUIRE_PRODUCTION_JUDGE_CALIBRATION=1
ALPHADECK_REQUIRE_INDEPENDENT_JUDGE=1
ALPHADECK_EVAL_DATASET_VISIBILITY=hidden
ALPHADECK_REPLAY_HASH_KEY=replace-with-16-plus-random-characters
ALPHADECK_HIDDEN_EVAL_CASES_PATH=/run/secrets/alphadeck-hidden-eval-cases.json
ALPHADECK_EVAL_JUDGE_CALIBRATION_PATH=/run/secrets/alphadeck-judge-calibration.json

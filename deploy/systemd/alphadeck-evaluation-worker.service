[Unit]
Description=AlphaDeck durable evaluation worker
After=network-online.target alphadeck-market-data.service
Wants=network-online.target
Requires=alphadeck-market-data.service

[Service]
Type=simple
User=alphadeck
Group=alphadeck
WorkingDirectory=/opt/alphadeck/current
EnvironmentFile=/etc/alphadeck/alphadeck.env
Environment=NODE_ENV=production
Environment=ALPHADECK_EVAL_ROOT=/opt/alphadeck/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env npm run worker:eval
Restart=on-failure
RestartSec=5s
TimeoutStopSec=180s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alphadeck /opt/alphadeck/current/tmp /opt/alphadeck/current/public/uploads
LimitNOFILE=65536

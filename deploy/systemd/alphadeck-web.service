[Unit]
Description=AlphaDeck standalone web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alphadeck
Group=alphadeck
WorkingDirectory=/opt/alphadeck/current
EnvironmentFile=/etc/alphadeck/alphadeck.env
Environment=NODE_ENV=production
Environment=ALPHADECK_EVAL_ROOT=/opt/alphadeck/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env node .next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alphadeck /opt/alphadeck/current/tmp /opt/alphadeck/current/public/uploads /opt/alphadeck/current/.next/standalone/.next/cache
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

[Unit]
Description=Create a verified AlphaDeck release backup
After=network-online.target

[Service]
Type=oneshot
User=alphadeck
Group=alphadeck
WorkingDirectory=/opt/alphadeck/current
EnvironmentFile=/etc/alphadeck/alphadeck.env
Environment=ALPHADECK_BACKUP_ROOT=/var/backups/alphadeck
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run db:backup:release
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/alphadeck /var/lib/alphadeck

[Unit]
Description=AlphaDeck market data API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alphadeck
Group=alphadeck
WorkingDirectory=/opt/alphadeck/current
EnvironmentFile=/etc/alphadeck/alphadeck.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=UV_CACHE_DIR=/var/cache/alphadeck/uv
ExecStart=/usr/bin/env uv run --frozen --extra baostock --extra akshare --project services/market-data alphadeck-market-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alphadeck /var/cache/alphadeck
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
